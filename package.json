{
  "name": "@vibe/bambu-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bambu Studio companion MCP：展平 preset 繼承鏈以修正 CLI 切片失真，並提供參數知識層、切片、模型可列印性與模型搜尋工具面。",
  "license": "UNLICENSED",
  "engines": {
    "node": "24.22.2"
  },
  "packageManager": "pnpm@11.17.0",
  "main": "./dist/index.js",
  "bin": {
    "bambu-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "smoke": "node scripts/stdio-smoke.mjs",
    "verify": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run smoke",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
